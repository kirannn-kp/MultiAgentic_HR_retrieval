# ------------------------------------------------------------------------------------------------
# Settings for the MB Enterprise consultation assistant.
# You normally do NOT edit this file: `setup.ps1` fills in the values marked (auto) for you.
# Leave PROJECT_ENDPOINT empty to run the offline simulation (no Azure needed).
# ------------------------------------------------------------------------------------------------

# auto = simulation while PROJECT_ENDPOINT is empty, real Foundry otherwise | true = always simulate | false = always real
MOCK_MODE=auto

# (auto) Microsoft Foundry
PROJECT_ENDPOINT=
PROJECT_RESOURCE_ID=
MODEL_DEPLOYMENT_NAME=gpt-4.1-mini
AZURE_OPENAI_ENDPOINT=

# (auto) Azure AI Search - hosts the Foundry IQ knowledge base
SEARCH_ENDPOINT=
SEARCH_API_VERSION=2026-08-01-preview
KNOWLEDGE_BASE_NAME=mb-enterprise-kb
KB_CONNECTION_NAME=mb-kb-mcp
ENABLE_WEB_SOURCE=true
WEB_ALLOWED_DOMAINS=

# Where the orchestrator runs:  local = on this computer | foundry = the A2A endpoint forwards to the hosted agent in Foundry (after deploy-hosted.ps1)
ORCHESTRATOR_MODE=local
HOSTED_ORCHESTRATOR_AGENT=risk-orchestrator

# Names of the agents created in Foundry
AGENT_RISK=risk-assessment-agent
AGENT_EVALUATOR=answer-evaluator-agent
AGENT_SERVICENOW=servicenow-agent
AGENT_MB_CHAT=mb-enterprise-chat-agent

# ---------------------------------- advanced (rarely changed) ----------------------------------
ORCHESTRATOR_HOST=127.0.0.1
ORCHESTRATOR_PORT=8001
MB_CHAT_HOST=127.0.0.1
MB_CHAT_PORT=8000
ORCHESTRATOR_URL=http://127.0.0.1:8001
MB_CHAT_URL=http://127.0.0.1:8000
CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
SHAREPOINT_MODE=sync
SHAREPOINT_SITE_URL=
SHAREPOINT_SITE_NAME=MB-Enterprise-POC
M365_TENANT_ID=
SHAREPOINT_APP_ID=
SHAREPOINT_APP_SECRET=
STORAGE_RESOURCE_ID=
ERD_CONTAINER=erd-policies
EMBEDDING_DEPLOYMENT_NAME=text-embedding-3-large
EMBEDDING_MODEL_NAME=text-embedding-3-large
